# ─── Relay environment ───────────────────────────────────────────────────────
# Copy to .env.local for local dev, and set the same keys in Netlify for prod.
# The app RUNS WITHOUT any of these (seeded mock data). Add them to turn on the
# real backend piece by piece.

# ── Supabase ──
# Create a project at supabase.com, run supabase/migrations/0001_init.sql in the
# SQL editor, then paste these from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Twilio (voice + SMS) ──
# From console.twilio.com. API Key/Secret: create under Account → API keys & tokens.
# TwiML App: create under Voice → TwiML Apps; point its Voice URL at
#   {PUBLIC_BASE_URL}/api/voice/outbound
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=

# Your purchased Relay number in E.164 (e.g. +12085550100). Shown as caller ID.
# ⚠️ Seth: this is the number-provisioning step — we pick these together.
TWILIO_CALLER_ID=

# Where inbound calls forward when you're not answering in-app (your real cell), E.164.
FORWARD_TO_NUMBER=

# Public HTTPS base URL Twilio can reach (Netlify URL, or an ngrok URL in dev).
PUBLIC_BASE_URL=http://localhost:3000

# ── Email (inbound reply parsing) ──
# Postmark or SendGrid. Point their inbound-parse webhook at
#   {PUBLIC_BASE_URL}/api/email/inbound
EMAIL_PROVIDER=postmark
EMAIL_SERVER_TOKEN=
EMAIL_FROM=
